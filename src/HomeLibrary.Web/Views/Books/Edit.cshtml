@model HomeLibrary.Web.Models.Books.BookEditViewModel
@{
    ViewData["Title"] = "Редактировать книгу";
}

<h1>Редактировать книгу</h1>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="book-form">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation"></div>
    <div class="field">
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="Author"></label>
        <input asp-for="Author" />
        <span asp-validation-for="Author" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="PublicationYear"></label>
        <input asp-for="PublicationYear" />
        <span asp-validation-for="PublicationYear" class="validation"></span>
    </div>
    <div class="field">
        <label asp-for="TableOfContentsHtml"></label>
        <div class="table-of-contents-editor" data-html-editor>
            <textarea asp-for="TableOfContentsHtml" rows="12" data-html-editor-input></textarea>
            <div class="wysiwyg-editor" data-html-editor-surface hidden></div>
        </div>
        <span asp-validation-for="TableOfContentsHtml" class="validation"></span>
    </div>
    <div class="actions">
        <button class="button" type="submit">Сохранить</button>
        <a asp-action="Details" asp-route-id="@Model.Id">Отмена</a>
    </div>
</form>

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" />
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>
    <script src="~/js/table-of-contents-editor.js" asp-append-version="true"></script>
}
