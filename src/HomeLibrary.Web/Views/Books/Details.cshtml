@model HomeLibrary.Web.Models.Books.BookDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="page-heading">
    <h1>@Model.Title</h1>
    <div class="actions">
        <a class="icon-button edit-button" asp-action="Edit" asp-route-id="@Model.Id"
           aria-label="Редактировать книгу" title="Редактировать">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                <path d="M4 20h4l11-11-4-4L4 16v4Z"></path>
                <path d="m13.5 6.5 4 4"></path>
            </svg>
        </a>
        <a asp-action="Index">К списку</a>
    </div>
</div>

<dl class="book-details">
    <dt>Название</dt>
    <dd>@Model.Title</dd>
    <dt>Автор</dt>
    <dd>@Model.Author</dd>
    <dt>Год издания</dt>
    <dd>@Model.PublicationYear</dd>
    <dt>Оглавление</dt>
    <dd><div class="table-of-contents">@Html.Raw(Model.TableOfContentsHtml)</div></dd>
    <dt>Создано</dt>
    <dd>@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
    <dt>Изменено</dt>
    <dd>@Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
</dl>
