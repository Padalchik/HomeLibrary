@model HomeLibrary.Web.Models.Books.BookIndexViewModel
@{
    ViewData["Title"] = "Книги";
}

<div class="page-heading">
    <h1>Домашняя библиотека</h1>
</div>

<div class="books-toolbar">
    <a class="button" asp-action="Create"><span aria-hidden="true">+</span> Добавить книгу</a>

    <form class="search-form" asp-action="Index" method="get">
        <div class="search-field">
            <svg class="search-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="m16 16 4 4"></path>
            </svg>
            <input id="search" name="search" type="search" value="@Model.Search"
                   placeholder="Поиск" aria-label="Поиск" autocomplete="off" />
        </div>
    </form>
</div>

@if (Model.Books.Count == 0 && string.IsNullOrWhiteSpace(Model.Search))
{
    <p class="empty-state">В библиотеке пока нет книг.</p>
}
else if (Model.Books.Count == 0)
{
    <p class="empty-state">По вашему запросу ничего не найдено.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Год</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var book in Model.Books)
            {
                <tr class="book-row" data-href="@Url.Action("Details", new { id = book.Id })"
                    tabindex="0" role="link">
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublicationYear</td>
                    <td class="actions book-actions">
                        <a class="icon-button edit-button" asp-action="Edit" asp-route-id="@book.Id"
                           aria-label="Редактировать книгу" title="Редактировать">
                            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                                <path d="M4 20h4l11-11-4-4L4 16v4Z"></path>
                                <path d="m13.5 6.5 4 4"></path>
                            </svg>
                        </a>
                        <form asp-action="Delete" asp-route-id="@book.Id" method="post"
                              onsubmit="return confirm('Удалить книгу?');">
                            <button class="icon-button delete-button" type="submit" aria-label="Удалить книгу" title="Удалить">
                                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
                                    <path d="M4 7h16"></path>
                                    <path d="M9 7V4h6v3"></path>
                                    <path d="m6.5 7 1 13h9l1-13"></path>
                                    <path d="M10 11v5M14 11v5"></path>
                                </svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script src="~/js/books-index.js" asp-append-version="true"></script>
}
