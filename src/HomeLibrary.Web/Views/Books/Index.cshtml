@model HomeLibrary.Web.Models.Books.BookIndexViewModel
@{
    ViewData["Title"] = "Книги";
}

<div class="page-heading">
    <h1>Домашняя библиотека</h1>
    <a class="button" asp-action="Create">Добавить книгу</a>
</div>

<form class="search-form" asp-action="Index" method="get">
    <div class="search-field">
        <label for="search">Поиск по названию, автору или оглавлению</label>
        <input id="search" name="search" type="search" value="@Model.Search" />
    </div>
    <button class="button" type="submit">Найти</button>
    @if (!string.IsNullOrWhiteSpace(Model.Search))
    {
        <a class="button secondary" asp-action="Index">Сбросить</a>
    }
</form>

@if (Model.Books.Count == 0 && string.IsNullOrWhiteSpace(Model.Search))
{
    <p class="empty-state">В библиотеке пока нет книг.</p>
}
else if (Model.Books.Count == 0)
{
    <p class="empty-state">По вашему запросу ничего не найдено.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Название</th>
                    <th>Автор</th>
                    <th>Год</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.PublicationYear</td>
                    <td class="actions">
                        <a asp-action="Details" asp-route-id="@book.Id">Просмотр</a>
                        <a asp-action="Edit" asp-route-id="@book.Id">Редактировать</a>
                        <form asp-action="Delete" asp-route-id="@book.Id" method="post"
                              onsubmit="return confirm('Удалить книгу?');">
                            <button class="link-button danger" type="submit">Удалить</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
